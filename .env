# Public frontend configuration for Lovable PUBLISHED builds.
#
# THIS FILE IS TRACKED ON PURPOSE. See docs/decisions.md (ADR-038).
#
# Lovable's published (non-Enterprise) builds do not receive git-ignored files,
# so the two PUBLIC browser values must be committed for the published app to
# configure itself. Both are shipped to every visitor's browser by design and
# are not secrets:
#
#   VITE_SUPABASE_URL              the hosted project's public API URL
#   VITE_SUPABASE_PUBLISHABLE_KEY  the publishable (anon) key
#
# What actually protects the data is Row Level Security, verified on the hosted
# project in WP4: `anon` holds zero table and zero column privileges, RLS is
# enabled on all four identity tables, and every policy requires an authenticated
# membership.
#
# ONLY these two variables may appear here. `bun run check:client-secrets`
# enforces that allowlist and fails the build on anything else - never add a
# service-role key, database password, access token or any other secret.
#
# Local development overrides this file with .env.local, which stays ignored.

VITE_SUPABASE_URL=https://nrfelnchbmofwrfajfai.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_WTwORwKrtBDaggzIkZo9tA_sMEVx-tt
