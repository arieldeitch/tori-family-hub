# Public runtime configuration (no secrets).
# Copy to .env.local and adjust as needed. Only public VITE_* values belong here.

VITE_APP_NAME=Tori
VITE_APP_LOCALE=he

# --- Supabase (local development) ---
# Public values ONLY. NEVER put the service role key, database password, or any
# access/refresh token here or anywhere in the repo. Get these two values from
# `bun run supabase:status` after `bun run supabase:start`.
#
# VITE_SUPABASE_URL      = the local API URL (default local port is 55321).
# VITE_SUPABASE_PUBLISHABLE_KEY = the local publishable (anon) client key.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-anon-key
